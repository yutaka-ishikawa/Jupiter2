diff --git a/common/spl/Kconfig b/common/spl/Kconfig
index e0e7b99..3ba1446 100644
--- a/common/spl/Kconfig
+++ b/common/spl/Kconfig
@@ -1548,6 +1548,14 @@ config SPL_OPENSBI
 	  More details are available at https://github.com/riscv/opensbi and
 	  https://github.com/riscv/riscv-sbi-doc
 
+config SPL_JUPITER2_MEASURED_BOOT
+	bool "Log Jupiter2 SPL FIT measurements"
+	depends on SPL_LOAD_FIT && SPL_OPENSBI
+	select SPL_SHA256
+	help
+	  Measure the loaded OpenSBI and U-Boot images and emit the TCG 2.0
+	  log to UART for development verification.
+
 config SPL_OPENSBI_LOAD_ADDR
 	hex "OpenSBI load address"
 	depends on SPL_OPENSBI
diff --git a/common/spl/spl_fit.c b/common/spl/spl_fit.c
index e22f605..cf56b0c 100644
--- a/common/spl/spl_fit.c
+++ b/common/spl/spl_fit.c
@@ -21,6 +21,11 @@
 #include <cpu_func.h>
 #include <linux/kernel.h>
 
+#ifdef CONFIG_SPL_JUPITER2_MEASURED_BOOT
+#include <jupiter2_measured_boot.h>
+#include <u-boot/sha256.h>
+#endif
+
 DECLARE_GLOBAL_DATA_PTR;
 
 #ifndef CONFIG_SPL_LOAD_FIT_APPLY_OVERLAY_BUF_SZ
@@ -727,6 +732,41 @@ static int spl_simple_fit_parse(struct spl_fit_info *ctx)
 	return 0;
 }
 
+#ifdef CONFIG_SPL_JUPITER2_MEASURED_BOOT
+static int jupiter2_measure(struct jupiter2_mb_log *log,
+			     const struct spl_image_info *image,
+			     const char *name)
+{
+    u8 digest[JUPITER2_MB_SHA256_SIZE];
+    const void *payload;
+
+    if (!image->size || image->load_addr > ~0UL - image->size) {
+	return -EINVAL;
+    }
+    payload = map_sysmem(image->load_addr, image->size);
+    sha256_csum_wd(payload, image->size, digest, CHUNKSZ_SHA256);
+    unmap_sysmem(payload);
+    /* PCR 0, EV_POST_CODE. */
+    return jupiter2_mb_append(log, 0, 1, digest, name, strlen(name) + 1);
+}
+
+static void jupiter2_print_log(const struct jupiter2_mb_log *log)
+{
+    size_t i;
+
+    printf("J2MB FIT log bytes=%zu\n", log->length);
+    for (i = 0; i < log->length; i++) {
+	if (i % 32 == 0) {
+	    printf("J2MB ");
+	}
+	printf("%02x", log->data[i]);
+	if (i % 32 == 31 || i + 1 == log->length) {
+	    puts("\n");
+	}
+    }
+}
+#endif
+
 int spl_load_simple_fit(struct spl_image_info *spl_image,
 			struct spl_load_info *info, ulong sector, void *fit)
 {
@@ -737,6 +777,13 @@ int spl_load_simple_fit(struct spl_image_info *spl_image,
 	int index = 0;
 	int firmware_node;
 
+#ifdef CONFIG_SPL_JUPITER2_MEASURED_BOOT
+    u8 measured_log[256];
+    struct jupiter2_mb_log log;
+    bool measure = false;
+    bool uboot_measured = false;
+#endif
+
 	ret = spl_simple_fit_read(&ctx, info, sector, fit);
