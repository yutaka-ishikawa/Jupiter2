 		if (ret < 0) {
@@ -836,6 +899,19 @@ int spl_load_simple_fit(struct spl_image_info *spl_image,
 		if (!spl_fit_image_get_os(ctx.fit, node, &os_type))
 			pr_debug("Loadable is %s\n", genimg_get_os_name(os_type));
 
+#ifdef CONFIG_SPL_JUPITER2_MEASURED_BOOT
+	if (measure && os_type == IH_OS_U_BOOT) {
+	    if (uboot_measured) {
