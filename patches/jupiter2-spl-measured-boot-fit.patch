 		return ret;
@@ -795,6 +842,19 @@ int spl_load_simple_fit(struct spl_image_info *spl_image,
 	else if (!IS_ENABLED(CONFIG_SPL_OS_BOOT))
 		spl_image->os = IH_OS_U_BOOT;
 
+#ifdef CONFIG_SPL_JUPITER2_MEASURED_BOOT
+    measure = spl_image->os == IH_OS_OPENSBI;
