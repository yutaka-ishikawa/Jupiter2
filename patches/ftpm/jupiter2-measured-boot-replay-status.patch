+	return false;
+    }
     log_extended = true;
     buf_index = process_header(buf_index, buf, log_size);
     if (buf_index == 0) {
@@ -379,7 +433,13 @@ bool process_eventlog(const unsigned char *const buf, const size_t log_size)
         /*
