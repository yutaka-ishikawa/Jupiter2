+	    event_header_ptr = NULL;
+	    return false;
+	}
+	buf_index = next;
         event_count++;
     }
 
@@ -389,5 +449,5 @@ bool process_eventlog(const unsigned char *const buf, const size_t log_size)
 
     event_header_ptr = NULL;
 
-    return true;
