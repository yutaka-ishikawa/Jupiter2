+static uint32_t read_le32(const unsigned char *p)
+{
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+	   (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* Validate the complete Jupiter2 SHA-256 profile before extending any PCR. */
+static bool valid_jupiter2_log(const unsigned char *buf, size_t size)
+{
+    static const unsigned char spec_id[] = {
+	'S', 'p', 'e', 'c', ' ', 'I', 'D', ' ',
+	'E', 'v', 'e', 'n', 't', '0', '3', 0,
+	0, 0, 0, 0, 0, 2, 0, 2, 1, 0, 0, 0,
+	0x0b, 0, 32, 0, 0,
+    };
+    static const unsigned char zero_digest[20];
+    const size_t header_size = 32;
+    const size_t record_size = 50;
+    size_t offset = header_size + sizeof(spec_id);
+
+    if (!buf || size <= offset || read_le32(buf) ||
+	read_le32(buf + 4) != EV_NO_ACTION ||
+	memcmp(buf + 8, zero_digest, sizeof(zero_digest)) ||
+	read_le32(buf + 28) != sizeof(spec_id) ||
+	memcmp(buf + header_size, spec_id, sizeof(spec_id))) {
+	return false;
+    }
+    while (offset < size) {
+	const unsigned char *event = buf + offset;
+	uint32_t data_size;
+
+	if (size - offset < record_size || read_le32(event) > 1 ||
+	    read_le32(event + 4) == EV_NO_ACTION ||
+	    read_le32(event + 8) != 1 || event[12] != 0x0b || event[13]) {
+	    return false;
+	}
+	data_size = read_le32(event + 46);
+	offset += record_size;
+	if (data_size > size - offset) {
+	    return false;
+	}
+	offset += data_size;
+    }
+    return true;
+}
+
 bool process_eventlog(const unsigned char *const buf, const size_t log_size)
 {
     unsigned int buf_index = 0U;
@@ -366,6 +417,9 @@ bool process_eventlog(const unsigned char *const buf, const size_t log_size)
         return false;
     }
 
