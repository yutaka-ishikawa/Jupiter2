@@ -734,7 +734,8 @@ static int spl_simple_fit_parse(struct spl_fit_info *ctx)
 
 #ifdef CONFIG_SPL_JUPITER2_MEASURED_BOOT
 static bool jupiter2_mb_ready;
-static u8 jupiter2_mb_buffer[256];
+static bool jupiter2_mb_collecting;
+static u8 jupiter2_mb_buffer[1024];
 static struct jupiter2_mb_log jupiter2_log;
 
 static int jupiter2_measure(struct jupiter2_mb_log *log,
@@ -759,6 +760,21 @@ static int jupiter2_measure(struct jupiter2_mb_log *log,
     return jupiter2_mb_append(log, 0, 1, digest, name, strlen(name) + 1);
 }
 
+int jupiter2_mb_measure_esos(const void *payload, size_t size, const char *name)
+{
+    u8 digest[JUPITER2_MB_SHA256_SIZE];
+
+    if (!jupiter2_mb_collecting) {
+	return 0;
+    }
+    if (!payload || !size || size > (unsigned int)-1) {
+	return -EINVAL;
+    }
+    sha256_csum_wd(payload, size, digest, CHUNKSZ_SHA256);
+    return jupiter2_mb_append(&jupiter2_log, 0, 1, digest,
+			      name, strlen(name) + 1);
+}
+
 static void jupiter2_print_log(const struct jupiter2_mb_log *log)
 {
     size_t i;
