diff --git a/core/arch/riscv/include/mm/generic_ram_layout.h b/core/arch/riscv/include/mm/generic_ram_layout.h
index 4903ade..4221090 100644
--- a/core/arch/riscv/include/mm/generic_ram_layout.h
+++ b/core/arch/riscv/include/mm/generic_ram_layout.h
@@ -163,7 +163,14 @@
 					SMALL_PAGE_SIZE)
 #endif /*CFG_WITH_PAGER*/
 
-#define TA_RAM_SIZE		(ROUNDDOWN(TDDRAM_BASE + (TDDRAM_SIZE - \
+#ifdef CFG_K3_FSBL_EVENT_LOG
+#define FSBL_LOG_RESERVED_SIZE CFG_K3_FSBL_EVENT_LOG_SIZE
+#else
+#define FSBL_LOG_RESERVED_SIZE 0
+#endif
+
+#define TA_RAM_SIZE		(ROUNDDOWN(TDDRAM_BASE + (TDDRAM_SIZE - \
+					  FSBL_LOG_RESERVED_SIZE - \
 					  TEE_SDP_TEST_MEM_SIZE), \
 					  SMALL_PAGE_SIZE) - TA_RAM_START)
